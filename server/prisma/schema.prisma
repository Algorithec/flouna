// Radiues data model.
// Dev runs on SQLite; production runs on PostgreSQL. Fields below avoid
// SQLite-only or Postgres-only types so the same schema compiles on both.
// Enum-like fields are strings validated by zod at the API boundary.
//
// Switching engines (the provider line below cannot use env(), so a script
// rewrites it):
//   Dev (default):   npm run db:provider          # -> sqlite
//   Production:      DB_PROVIDER=postgresql npm run db:deploy
//                    (sets postgresql, runs `prisma migrate deploy` + generate)
// Set DATABASE_URL to the Postgres connection string in the prod environment.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String?
  googleId      String?   @unique
  phone         String?   @unique
  emailVerified Boolean   @default(false)
  phoneVerified Boolean   @default(false)
  avatarUrl     String?
  weeklyFoodBudgetPaise Int? // Budget Guardian — null = not set
  // Notification preferences (Settings). OTP/security mail always sends;
  // emailUpdates gates non-essential mail (receipts, announcements) and
  // smartSuggestions gates the AI suggestion surfaces in the app.
  emailUpdates     Boolean @default(true)
  smartSuggestions Boolean @default(true)
  // Radiues Plus (₹50/mo). Live tracking stays free for everyone; this unlocks
  // deeper AI, waived convenience fees and the savings guarantee.
  plusActive    Boolean   @default(false)
  plusSince     DateTime?
  plusUntil     DateTime? // current period end; expired = treated as inactive
  failedLogins  Int       @default(0) // consecutive failed login attempts
  lockedUntil   DateTime? // set after too many failures (backoff window)
  // RBAC: "user" | "developer" | "admin" | "super_admin". Stored as a string
  // (SQLite/Postgres parity) and validated in code. Only a super_admin can
  // change this; never settable via signup or profile update. Default keeps
  // every account a plain user until explicitly promoted.
  role          String    @default("user")
  // Operator accounts (non-user roles) suspended by a super_admin can't sign in.
  suspendedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  addresses     Address[]
  chatSessions  ChatSession[]
  orders        Order[]
  payments      Payment[]
  otpCodes      OtpCode[]
  refreshTokens RefreshToken[]
  pushSubscriptions PushSubscription[]
  hostedCarts   GroupCart[]     @relation("HostedCarts")
  groupCartItems GroupCartItem[]
  groupCartMemberships GroupCartMember[]
  priceAlerts   PriceAlert[]
  supportTickets SupportTicket[]
}

// Group ordering: a shared cart one person hosts and others join via a code.
// Each member adds their own items; the bill splits equally on checkout.
model GroupCart {
  id          String   @id @default(cuid())
  code        String   @unique // short human-shareable join code
  hostId      String
  host        User     @relation("HostedCarts", fields: [hostId], references: [id], onDelete: Cascade)
  // "food": members add dishes, host checks out the combined cart.
  // "ride": one shared trip, fare split equally among members.
  domain      String   @default("food")
  platform    String // food: source network id · ride: provider id
  // Ride carts only: JSON snapshot of the trip taken at creation —
  // pickup/drop labels + coords, product/display name, vehicle, fare estimate.
  // The fare is recomputed server-side at checkout; this is the display copy.
  rideDetails String?
  status      String   @default("open") // "open" | "locked" | "ordered" | "cancelled"
  orderId     String? // set once the host places the combined order
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items   GroupCartItem[]
  members GroupCartMember[]

  @@index([hostId])
}

// Explicit membership: created when someone joins via code (and for the host).
// Gates who may read/add to a cart, independent of whether they've added items.
model GroupCartMember {
  id        String    @id @default(cuid())
  cartId    String
  cart      GroupCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([cartId, userId])
  @@index([userId])
}

model GroupCartItem {
  id         String    @id @default(cuid())
  cartId     String
  cart       GroupCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dishId     String
  name       String
  pricePaise Int // unit effective price snapshot
  qty        Int       @default(1)
  createdAt  DateTime  @default(now())

  @@index([cartId])
}

// "Tell me when this drops below ₹X." A background loop checks active alerts
// against the latest observed prices and fires a push + realtime event.
model PriceAlert {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain        String // "food" | "ride"
  itemKey       String // dishId (food) or vehicle type (ride)
  itemName      String // human label shown in the notification
  targetPaise   Int // notify when best price <= this
  lastSeenPaise Int // price at the time the alert was created
  active        Boolean   @default(true)
  triggeredAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId, active])
  @@index([domain, itemKey, active])
}

// Observed best prices over time. Every quote generation logs one row, so the
// timing advisor can learn real hour-of-day patterns instead of fixed rules.
model PriceObservation {
  id          String   @id @default(cuid())
  domain      String // "food" | "ride"
  key         String // dishId (food) or vehicle type (ride)
  hour        Int // 0–23, local hour the quote was seen
  weekday     Int // 0–6 (Mon=0)
  bestPaise   Int // cheapest effective price at that moment
  createdAt   DateTime @default(now())

  @@index([domain, key, hour])
}

// Web Push subscriptions (W3C Push API). One row per browser/device a user
// has granted notification permission on. `endpoint` is unique per device.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String // client public key
  auth      String // client auth secret
  createdAt DateTime @default(now())

  @@index([userId])
}

// One-time codes for email verification now; `channel` supports "phone"
// so SMS OTP can be added later without a schema change.
model OtpCode {
  id         String    @id @default(cuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel    String // "email" | "phone"
  target     String // email address or phone number the code was sent to
  codeHash   String // bcrypt hash — raw codes are never stored
  purpose    String // "signup" | "login" | "reset"
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([target, purpose])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  // Whether this session cleared operator step-up (2FA). Carried across refresh
  // rotation so a stepped-up console session keeps the `step` claim on its new
  // access token; ordinary user sessions stay false.
  stepUp    Boolean   @default(false)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String // "Home" | "Work" | custom
  line1     String
  city      String
  state     String
  pincode   String
  lat       Float?
  lng       Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ChatSession {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String // "user" | "assistant"
  content   String
  intent    String? // JSON: extracted intent / recommendation payload
  createdAt DateTime    @default(now())

  @@index([sessionId])
}

// Unified order for both domains; domain-specific details live in `details` JSON.
model Order {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain      String // "food" | "ride"
  status      String // "created" | "pending_payment" | "confirmed" | "in_progress" | "completed" | "cancelled"
  provider    String // "ondc" | "swiggy" | "zomato" | "uber" | "ola" | "rapido" (simulated for now)
  fulfillment String // "in_app" (ONDC) | "redirect" (closed platform)
  title       String // human-readable summary, e.g. "Dum Biryani — Hotel Paradise"
  details     String // JSON: items / route / provider quote snapshot
  amount      Int // paise — integer money, never floats
  savedPaise  Int      @default(0) // vs next-best option at decision time
  currency    String   @default("INR")
  addressId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payment        Payment?
  trackingEvents TrackingEvent[]

  @@index([userId, domain])
}

model Payment {
  id              String    @id @default(cuid())
  orderId         String    @unique
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gateway         String    @default("cashfree")
  gatewayOrderId  String?   @unique // Cashfree order id
  amount          Int // paise
  currency        String    @default("INR")
  status          String // "created" | "processing" | "success" | "failed" | "refunded"
  method          String? // "upi" | "card" | "netbanking"
  gatewayResponse String? // JSON: last webhook/verify payload
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model TrackingEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String // e.g. "order_placed" | "preparing" | "out_for_delivery" | "driver_assigned" | "arriving" | "completed"
  message   String
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())

  @@index([orderId])
}

// --- Back-office (admin / super-admin / developer consoles) ---

// Append-only record of every privileged action. Written by the audit service
// on each mutating admin/super operation. There is no update or delete path —
// the super-admin reviews it as a tamper-evident trail (who did what, to whom,
// from where). actorId is null only for system-originated entries.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String? // the operator who acted (null = system)
  actorRole  String // role at the time of the action
  action     String // e.g. "user.suspend", "role.grant", "order.refund_flag"
  targetType String // "user" | "order" | "ticket" | "flag" | ...
  targetId   String? // id of the affected entity
  summary    String // human-readable one-liner for the audit feed
  metadata   String? // JSON: before/after or extra context
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// Captured server errors, surfaced on the developer console. Every unhandled
// error flows here via the error handler so engineers see failures without SSH.
// fingerprint groups identical errors; count rises instead of spamming rows.
model ErrorLog {
  id          String   @id @default(cuid())
  fingerprint String   @unique // hash of name+message+top frame
  name        String // error class, e.g. "TypeError"
  message     String
  stack       String?
  route       String? // method + path that triggered it
  statusCode  Int? // HTTP status returned, if any
  userId      String? // affected user, when known (no PII beyond id)
  count       Int      @default(1) // occurrences of this fingerprint
  resolved    Boolean  @default(false) // engineer marks handled
  firstSeen   DateTime @default(now())
  lastSeen    DateTime @default(now())

  @@index([resolved, lastSeen])
}

// Support / Issue-&-Grievance (ONDC IGM-shaped) ticket raised by a user and
// worked by admins. Keeps order disputes auditable end to end.
model SupportTicket {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId    String? // optional link to the order in question
  category   String // "order" | "payment" | "refund" | "account" | "other"
  subject    String
  body       String
  status     String   @default("open") // "open" | "in_progress" | "resolved" | "closed"
  priority   String   @default("normal") // "low" | "normal" | "high" | "urgent"
  assigneeId String? // admin handling it
  resolution String? // closing note
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, priority])
  @@index([userId])
}

// Server-side feature flags, toggled from the developer console. Lets us gate
// risky features (e.g. switch LLM_PROVIDER behaviour, enable ONDC live) without
// a redeploy. Read at request time; default off when absent.
model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "ondc_live", "hybrid_ai_rerank"
  enabled     Boolean  @default(false)
  description String?
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

// API keys for MSME / developer-partner integrations (managed from the
// super-admin console). We store only a SHA-256 hash of the secret — the raw
// key is shown exactly once at creation and never persisted, so a DB leak
// exposes nothing usable. `prefix` is a non-secret label for display/lookup.
model ApiKey {
  id          String    @id @default(cuid())
  name        String // e.g. "Production — MK Electronics"
  client      String // owning partner / integration
  prefix      String    @unique // e.g. "alg_live_4f2a" (non-secret, shown in UI)
  keyHash     String    @unique // sha256 of the full key
  scope       String    @default("read") // "read" | "read_write"
  createdById String?
  lastUsedAt  DateTime?
  callCount   Int       @default(0)
  expiresAt   DateTime? // null = no expiry
  revokedAt   DateTime? // set instead of deleting, for audit continuity
  createdAt   DateTime  @default(now())

  @@index([revokedAt])
}

// ONDC transaction log (developer console). Radiues is a BAP: every order is a
// Beckn flow of signed request/callback pairs (search→on_search, select→
// on_select, confirm→on_confirm, status→on_status). Until participant
// registration these are SIMULATED from real orders but recorded in the exact
// envelope shape, so the viewer — and any downstream tooling — works unchanged
// the moment the network goes live. `simulated` flags pre-registration rows.
model OndcTransaction {
  id          String   @id @default(cuid())
  txnId       String // Beckn transaction_id (one per order/journey)
  messageId   String // Beckn message_id (one per request/callback pair)
  action      String // "search" | "on_search" | "select" | "confirm" | "on_confirm" | "status" | "on_status"
  domain      String // ONDC domain code, e.g. "ONDC:RET11" (food) / "ONDC:TRV11"
  orderId     String? // our order this relates to, when applicable
  bppId       String? // the seller app (BPP) the message went to/from
  request     String? // JSON: the Beckn request envelope (context + message)
  response    String? // JSON: the matching callback envelope, when present
  status      String // "ack" | "nack" | "error"
  signed      Boolean  @default(true) // request carried an Ed25519 signature
  latencyMs   Int? // round-trip for request→callback, when known
  simulated   Boolean  @default(true) // pre-registration synthetic record
  createdAt   DateTime @default(now())

  @@index([txnId])
  @@index([action, createdAt])
  @@index([orderId])
}

// Singleton-ish platform configuration set from the super-admin Settings page:
// commission thresholds (kept within DPIIT/ONDC norms) and alert thresholds. A
// single row with key "default"; values are integers/basis-points to avoid
// floats. Read by services that enforce or display these limits.
model PlatformConfig {
  id                       String   @id @default(cuid())
  key                      String   @unique @default("default")
  // Commission thresholds in basis points (1% = 100 bps) — integer money rule.
  ondcMinMarginBps         Int      @default(300) // 3.0%
  ondcMaxMarginBps         Int      @default(600) // 6.0%
  partnerAffiliateMinBps   Int      @default(120) // 1.2%
  cashbackUserSharePct     Int      @default(30) // % of cashback passed to user
  // Alert thresholds.
  apiFailureRatePct        Int      @default(1) // alert when failure% exceeds
  decisionLatencyAlertSec  Int      @default(5)
  ondcPingAlertMs          Int      @default(500)
  updatedById              String?
  updatedAt                DateTime @updatedAt
  createdAt                DateTime @default(now())
}
