// Flouna data model.
// Dev runs on SQLite; production runs on PostgreSQL. Fields below avoid
// SQLite-only or Postgres-only types so the same schema compiles on both.
// Enum-like fields are strings validated by zod at the API boundary.
//
// Switching engines (the provider line below cannot use env(), so a script
// rewrites it):
//   Dev (default):   npm run db:provider          # -> sqlite
//   Production:      DB_PROVIDER=postgresql npm run db:deploy
//                    (sets postgresql, runs `prisma migrate deploy` + generate)
// Set DATABASE_URL to the Postgres connection string in the prod environment.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  name                  String
  passwordHash          String?
  googleId              String?   @unique
  phone                 String?   @unique
  emailVerified         Boolean   @default(false)
  phoneVerified         Boolean   @default(false)
  avatarUrl             String?
  // Collected at sign-up (optional). Stored so the account actually keeps what
  // the user typed — previously the form asked for it and threw it away.
  dateOfBirth           String? // ISO yyyy-mm-dd
  // Free text rather than an enum: the Personal Information screen offers a
  // short list, but a fixed set in the database would make adding an option a
  // migration, and would force users whose answer isn't listed into a wrong one.
  gender                String?
  weeklyFoodBudgetPaise Int? // Budget Guardian — null = not set
  // Notification preferences (Settings). OTP/security mail always sends;
  // emailUpdates gates non-essential mail (receipts, announcements) and
  // smartSuggestions gates the AI suggestion surfaces in the app.
  emailUpdates          Boolean   @default(true)
  smartSuggestions      Boolean   @default(true)
  // Outbox category toggles. Security mail always sends (no toggle);
  // emailUpdates keeps gating order/receipt mail.
  emailMoneyUpdates     Boolean   @default(true) // savings, price drops, Plus ROI
  emailTips             Boolean   @default(true) // lifecycle nudges & announcements
  // Privacy & Security. Gates the rides screen auto-detecting the rider's
  // position on load; they can still pick a pickup by hand or tap the locate
  // control, which is an explicit request rather than a silent read.
  shareLocation         Boolean   @default(true)
  // Who may see this account's name and photo where Flouna shows one user to
  // another — today that is the group-cart member list, the only place the
  // product puts two accounts in the same room. "everyone" | "contacts" |
  // "nobody"; "contacts" means people who have shared a group cart before.
  profileVisibility     String    @default("everyone")
  // Whether other members of a shared cart see this account as recently active.
  activityStatus        Boolean   @default(true)
  // Email one-time code required on every password login, on top of the
  // password itself. Reuses the same OTP machinery the operator console's
  // step-up already runs on.
  twoFactorEnabled      Boolean   @default(false)
  // Consent has to be demonstrable under DPDP s.6, so we record which version
  // of the terms this account agreed to and when, rather than inferring it
  // from the fact that they have an account at all.
  termsAcceptedAt       DateTime?
  termsVersion          String?
  // Cookie categories. Essential has no column because it cannot be switched
  // off. The rest default to false, which is the only honest default for a
  // choice the person has not made yet.
  cookieChoiceAt        DateTime?
  cookieAnalytics       Boolean   @default(false)
  cookieAdvertising     Boolean   @default(false)
  cookieSocial          Boolean   @default(false)
  cookiePerformance     Boolean   @default(false)
  // Privacy policy 6.4: excluded from model training on request.
  aiTrainingOptOut      Boolean   @default(false)
  // Privacy policy 6.2. Deletion is scheduled, not immediate: the policy
  // allows 30 to 45 days to process, and transaction rows have to survive 7
  // years for tax, so the erase step anonymises those rather than dropping
  // them. deletedAt marks the account erased without freeing the email.
  deletionRequestedAt   DateTime?
  deletionScheduledFor  DateTime?
  deletedAt             DateTime?
  // Flouna Plus (₹50/mo). Live tracking stays free for everyone; this unlocks
  // deeper AI, waived convenience fees and the savings guarantee.
  plusActive            Boolean   @default(false)
  plusSince             DateTime?
  plusUntil             DateTime? // current period end; expired = treated as inactive
  failedLogins          Int       @default(0) // consecutive failed login attempts
  lockedUntil           DateTime? // set after too many failures (backoff window)
  // RBAC: "user" | "developer" | "admin" | "super_admin". Stored as a string
  // (SQLite/Postgres parity) and validated in code. Only a super_admin can
  // change this; never settable via signup or profile update. Default keeps
  // every account a plain user until explicitly promoted.
  role                  String    @default("user")
  // Operator accounts (non-user roles) suspended by a super_admin can't sign in.
  suspendedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  addresses            Address[]
  chatSessions         ChatSession[]
  orders               Order[]
  ondcSearches         OndcSearch[]
  ondcOrders           OndcOrder[]
  ondcRides            OndcRide[]
  cart                 Cart?
  payments             Payment[]
  otpCodes             OtpCode[]
  refreshTokens        RefreshToken[]
  pushSubscriptions    PushSubscription[]
  hostedCarts          GroupCart[]         @relation("HostedCarts")
  groupCartItems       GroupCartItem[]
  groupCartMemberships GroupCartMember[]
  ownedCrews           GroupCrew[]         @relation("OwnedCrews")
  crewMemberships      GroupCrewMember[]
  chatDevices          ChatDevice[]
  sentSenderKeys       SenderKeyEnvelope[] @relation("SentSenderKeys")
  receivedSenderKeys   SenderKeyEnvelope[] @relation("ReceivedSenderKeys")
  historySyncs         HistorySync[]
  groupMessages        GroupMessage[]
  priceAlerts          PriceAlert[]
  supportTickets       SupportTicket[]
  notifications        Notification[]
  complaints           Complaint[]
  paymentMethods       PaymentMethod[]
  walletEntries        WalletEntry[]
  supportChats         SupportChat[]
  blocks               BlockedUser[]       @relation("Blocker")
  blockedBy            BlockedUser[]       @relation("Blocked")
  deviceLocks          DeviceLock[]
  consents             ConsentRecord[]
  privacyRequests      PrivacyRequest[]
  decisionAppeals      DecisionAppeal[]
}

// Help Centre conversation. One row per time the customer opens support.
//
// The assistant that answers is deterministic and reads the customer's own
// orders, refunds and complaints — see support.bot.ts. That matters here
// because it means a transcript is reproducible: the same account state and the
// same question give the same answer, which is what makes a support log worth
// keeping.
model SupportChat {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // What the customer came in about, when they arrived from a Top Topics row.
  topic    String?
  // The order under discussion, once the conversation settles on one.
  orderId  String?
  // "open" | "resolved" | "escalated" | "closed"
  status   String  @default("open")
  // Set when the conversation is handed to a human; the ticket carries it on.
  ticketId String?

  // Post-chat rating, asked for automatically once the chat ends.
  ratingStars   Int?
  ratingComment String?
  ratedAt       DateTime?

  startedAt DateTime  @default(now())
  endedAt   DateTime?
  updatedAt DateTime  @updatedAt

  messages SupportMessage[]

  @@index([userId, status])
}

model SupportMessage {
  id        String      @id @default(cuid())
  chatId    String
  chat      SupportChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  // "user" | "bot" | "agent" — agent is a human replying from the console.
  role      String
  body      String
  // Quick replies offered alongside a bot message, as a JSON array of
  // { label, value }. Stored rather than recomputed so the transcript shows
  // what the customer was actually offered at the time.
  options   String?
  createdAt DateTime    @default(now())

  @@index([chatId])
}

// Rewards wallet, kept as an append-only ledger rather than a balance column.
// The balance is always the sum of these rows, so it cannot drift out of step
// with the events that produced it, and every rupee on the Offers & Rewards
// screen can be traced back to the order that earned it. Integer paise, like
// every other money value here.
//
// amountPaise is signed: positive credits, negative debits. A debit is never
// written without first checking the summed balance inside the same
// transaction, which is what stops a double-spend from two parallel requests.
model WalletEntry {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountPaise Int
  // "cashback" | "spend" | "refund" | "adjustment"
  reason      String
  // Human-readable line for the history screen.
  description String
  orderId     String?
  createdAt   DateTime @default(now())

  @@unique([userId, orderId, reason])
  @@index([userId])
}

// Someone this account has blocked. Enforced where the product actually puts
// two users together: a blocked user can't join a cart you host, and you can't
// join theirs. Kept as its own row (not a JSON list) so the reverse lookup —
// "did they block me?" — is a plain indexed query.
model BlockedUser {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("Blocker", fields: [userId], references: [id], onDelete: Cascade)
  blockedUserId String
  blockedUser   User     @relation("Blocked", fields: [blockedUserId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([userId, blockedUserId])
  @@index([userId])
  @@index([blockedUserId])
}

// A platform authenticator (fingerprint / face) registered on one device to
// lock the app on that device. Deliberately NOT a login factor: the assertion
// is checked by the device's own authenticator and gates the app shell, so this
// stores which devices have the lock armed rather than a public key it would
// have to verify signatures against.
model DeviceLock {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique
  label        String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

// Saved payment methods for quick display/reuse — deliberately not a card
// vault. A real charge still goes through Cashfree's own hosted checkout at
// payment time (see the payments module); storing a full card number or CVV
// here would be a PCI-DSS problem this app has no business taking on. Cards
// keep only what's needed to recognise them (brand, last 4, expiry) — never
// the number itself. UPI, by contrast, really is just an identifier, so
// that's the one type this can actually authenticate as entered.
model PaymentMethod {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String // "card" | "upi" | "wallet"
  label       String // "Visa", "Mastercard", "Paytm Wallet", ...
  last4       String? // cards only
  expiryMonth Int? // cards only
  expiryYear  Int? // cards only
  vpa         String? // upi only — the VPA itself (name@bank)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// ONDC IGM 2.0 — issue & grievance management.
//
// This is a case-management model, not a contact form. ONDC verifies it in a
// live walkthrough, so every customer-facing event has to be reconstructable
// from a backend record.
//
// Two rules shape the design:
//
//   1. The internal model is kept separate from ONDC protocol payloads. Nothing
//      here mirrors a wire schema — an adapter maps between the two, so a spec
//      version bump touches the adapter and not the database or the UI.
//   2. Enum-like fields are plain strings validated at the API boundary, the
//      same convention the rest of this schema uses for SQLite/Postgres parity.
//      The ONDC-controlled vocabularies (category, sub-category, action codes)
//      are deliberately NOT hard-coded as Prisma enums: the integration guide is
//      explicit that inventing enum values is wrong, and the real ones must come
//      from the live spec.
//
// Deliberately separate from SupportTicket. That model is a simple internal
// helpdesk ticket with no action trail, actors, resolutions or protocol log;
// bending it into IGM shape would lose both.
model Complaint {
  id     String @id @default(cuid())
  // Human/network-facing reference shown to the customer and sent as the issue
  // id (e.g. "ALG-000123"). Distinct from the cuid primary key.
  code   String @unique
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A complaint can be about the whole order, specific items, or a fulfilment —
  // the guide is explicit that order-level is not the only case. itemIds is a
  // JSON array of strings (SQLite has no array type).
  orderId       String?
  fulfillmentId String?
  itemIds       String  @default("[]")

  // ONDC-controlled vocabulary; validated against the spec at the boundary.
  category    String
  subCategory String?
  // "ISSUE" | "GRIEVANCE" — grievance is the escalated form.
  issueType   String  @default("ISSUE")
  description String

  // Customer-visible state: OPEN | PROCESSING | RESOLVED | CLOSED. The richer
  // protocol events live in ComplaintAction so the audit trail is never
  // flattened into these four.
  status String @default("OPEN")

  // 0 = none, 1 = GRO, 2 = ONDC CARE/dispute.
  escalationLevel Int @default(0)

  // Identifiers assigned by the network once the issue is sent. Null until then,
  // which is also how "not yet transmitted" is represented.
  ondcIssueId       String? @unique
  ondcTransactionId String?

  // Set when the seller asks for more information, cleared when it is supplied —
  // this is what the UI reads to show the "reply" state.
  infoRequestedAt DateTime?
  infoRequest     String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?
  closedAt   DateTime?

  // The deadlines support policy 3.7 publishes, stamped when the case opens.
  // Stored rather than recomputed, so amending the policy later cannot move a
  // commitment already made to this person.
  assignBy      DateTime?
  contactBy     DateTime?
  investigateBy DateTime?
  assignedAt    DateTime?
  contactedAt   DateTime?
  // Who is handling it. Free text rather than a relation to User: a grievance
  // officer is a role a person holds, and the IT Rules ask us to publish who
  // it is, not to guarantee they hold an account in this system.
  officerId     String?
  // The written conclusion given to the customer.
  resolution    String?

  // One internal appeal, decided within 15 days (3.7 step 5).
  appealedAt    DateTime?
  appealDueBy   DateTime?
  appealOutcome String?

  actors      ComplaintActor[]
  actions     ComplaintAction[]
  messages    ComplaintMessage[]
  evidence    ComplaintEvidence[]
  resolutions ComplaintResolution[]
  escalations ComplaintEscalation[]
  refunds     ComplaintRefund[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([orderId])
}

// CONSUMER | INTERFACING-NP | SELLER-NP | GRO | ONDC. IGM 2.0 replaced the old
// complainant_info with explicit actors, so they are first-class rows here.
model ComplaintActor {
  id          String    @id @default(cuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  actorId     String // network-facing id, e.g. "CUST-001"
  actorType   String
  name        String?
  // JSON blob for the optional actor_details the spec allows.
  details     String?
  createdAt   DateTime  @default(now())

  @@unique([complaintId, actorId])
  @@index([complaintId])
}

// The audit trail. Every state change — ours or the network's — appends a row;
// nothing is ever mutated in place. lastActionId chains actions so the case can
// be replayed in order, which is what ONDC asks to see.
model ComplaintAction {
  id           String    @id @default(cuid())
  complaintId  String
  complaint    Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  // Protocol action id where one exists; ours otherwise. Unique so a replayed
  // callback cannot append the same action twice.
  actionId     String    @unique
  // ACKNOWLEDGED | INFO_REQUESTED | INFO_PROVIDED | RESOLUTION_PROPOSED |
  // RESOLUTION_ACCEPTED | RESOLUTION_REJECTED | ESCALATED | REFUND_INITIATED |
  // REFUND_COMPLETED | CREATED | STATUS_REQUESTED
  code         String
  // Customer-safe sentence. Raw protocol JSON never reaches the UI.
  description  String
  actionBy     String // actor type that performed it
  actorId      String?
  lastActionId String?
  createdAt    DateTime  @default(now())

  @@index([complaintId, createdAt])
}

// Raw protocol traffic, kept apart from the customer-facing trail above so the
// UI never depends on wire format. Payloads are stored for audit and debugging
// and are never served to the app.
model ComplaintMessage {
  id          String    @id @default(cuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  direction   String // "outbound" | "inbound"
  action      String // issue | on_issue | issue_status | on_issue_status
  // Protocol message id — the idempotency key for inbound callbacks.
  messageId   String?   @unique
  payload     String // raw JSON as received/sent
  status      String    @default("pending") // pending | acked | failed
  error       String?
  sentAt      DateTime?
  receivedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([complaintId, createdAt])
}

// File metadata only. The guide is explicit that private storage URLs must not
// be exposed, so the app is handed an id and the server resolves a short-lived
// link when one is actually needed.
model ComplaintEvidence {
  id          String    @id @default(cuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  storageKey  String
  mimeType    String
  sizeBytes   Int
  // Which side supplied it — the customer, or the network.
  uploadedBy  String    @default("CONSUMER")
  createdAt   DateTime  @default(now())

  @@index([complaintId])
}

// Resolutions are a list, not a field: IGM 2.0 lets a seller propose several,
// and different ones per item. Modelling this as a single column on Complaint
// would make item-specific proposals unrepresentable.
model ComplaintResolution {
  id               String    @id @default(cuid())
  complaintId      String
  complaint        Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  resolutionId     String    @unique // protocol id
  itemId           String? // null = applies to the whole order
  // REFUND | REPLACEMENT | PARTIAL_REFUND | NO_ACTION — from the spec.
  type             String
  // Integer paise, like every other money value in this schema. Null when the
  // resolution isn't financial.
  amountPaise      Int?
  description      String
  proposedBy       String    @default("SELLER-NP")
  // null = awaiting the customer, then "accepted" | "rejected".
  customerDecision String?
  decidedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([complaintId])
}

// Refund tracking, kept apart from the IGM conversation on purpose. An accepted
// resolution is a promise; money moving is a separate fact with its own
// reference and status, and the guide warns against conflating them.
model ComplaintRefund {
  id               String    @id @default(cuid())
  complaintId      String
  complaint        Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  orderId          String?
  amountPaise      Int
  paymentReference String?
  refundReference  String?
  // initiated | processing | completed | failed. Never set to completed just
  // because a resolution was accepted — only on authoritative confirmation.
  status           String    @default("initiated")
  initiatedAt      DateTime  @default(now())
  completedAt      DateTime?

  @@index([complaintId])
}

model ComplaintEscalation {
  id          String    @id @default(cuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  level       Int // 1 = GRO, 2 = ONDC
  reason      String
  targetActor String
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([complaintId])
}

// Email-notification outbox: every user-facing email (except time-critical
// OTP) is enqueued here and drained by a worker — idempotent via dedupeKey,
// preference-gated per category, capped per user per day.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // registry key, e.g. "security.password_changed"
  payload   String    @default("{}") // JSON string (SQLite has no Json type)
  dedupeKey String?   @unique // same key twice = second enqueue is a no-op
  status    String    @default("queued") // queued | sent | skipped | failed
  attempts  Int       @default(0)
  error     String?
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, sentAt])
}

// Group ordering: a shared cart one person hosts and others join via a code.
// Each member adds their own items; the bill splits equally on checkout.
model GroupCart {
  id          String     @id @default(cuid())
  code        String     @unique // short human-shareable join code
  hostId      String
  host        User       @relation("HostedCarts", fields: [hostId], references: [id], onDelete: Cascade)
  // "food": members add dishes, host checks out the combined cart.
  // "ride": one shared trip, fare split equally among members.
  domain      String     @default("food")
  platform    String // food: source network id · ride: provider id
  // Ride carts only: JSON snapshot of the trip taken at creation —
  // pickup/drop labels + coords, product/display name, vehicle, fare estimate.
  // The fare is recomputed server-side at checkout; this is the display copy.
  rideDetails String?
  status      String     @default("open") // "open" | "locked" | "ordered" | "cancelled"
  // What the group is called ("Biryani Group") plus an optional emoji. Set by
  // the host; falls back to a generated name so a cart is never nameless.
  name        String?
  emoji       String?
  // The saved crew this cart was opened from, if any. Kept so reopening the
  // crew can offer what they ordered last time.
  crewId      String?
  crew        GroupCrew? @relation(fields: [crewId], references: [id], onDelete: SetNull)
  // How many people the host said the order is for, counting the host
  // ("a group order for four"). Shown as joined of expected; it never stops
  // anyone joining or limits the order.
  expectedMembers Int?
  orderId     String? // set once the host places the combined order
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  items      GroupCartItem[]
  members    GroupCartMember[]
  messages   GroupMessage[]
  senderKeys SenderKeyEnvelope[]
  histories  HistorySync[]

  @@index([hostId])
  @@index([crewId])
}

// A saved crew: the people you order with again and again ("Friday biryani").
// Reopening one creates a fresh cart with the same members already invited, so
// the second order costs one tap instead of another round of link-sharing.
model GroupCrew {
  id         String   @id @default(cuid())
  ownerId    String
  owner      User     @relation("OwnedCrews", fields: [ownerId], references: [id], onDelete: Cascade)
  name       String
  emoji      String?
  // Crews are per-domain: a food crew and a ride crew are different habits
  // even when they contain the same people.
  domain     String   @default("food")
  platform   String
  // The most recent cart opened from this crew, so "order the usual" has
  // something concrete to copy.
  lastCartId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  members GroupCrewMember[]
  carts   GroupCart[]

  @@unique([ownerId, name, domain])
  @@index([ownerId])
}

model GroupCrewMember {
  id        String    @id @default(cuid())
  crewId    String
  crew      GroupCrew @relation(fields: [crewId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([crewId, userId])
  @@index([userId])
}

// ---------- end-to-end encrypted group chat ----------
//
// The server is a courier here, not a reader. It holds public keys, sealed
// envelopes it cannot open, and ciphertext it cannot decrypt. The private half
// of every key is generated in the browser and never leaves the device.

/**
 * One browser's identity key. The public half only — the private half stays
 * in that browser's IndexedDB as a non-extractable CryptoKey.
 */
model ChatDevice {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /**
   * Random id the browser generates for itself.
   */
  deviceId   String
  /**
   * Base64 SPKI of an ECDH P-256 public key. Used to seal things TO this
   * device.
   */
  publicKey  String
  /**
   * Base64 SPKI of an ECDSA P-256 public key. Used to prove something came
   * FROM this device. Without it every member shares one key, and any member
   * can write a message that looks like it came from another.
   */
  signingKey String?
  label      String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([userId, deviceId])
  @@index([userId])
}

/**
 * The group's symmetric key, sealed for exactly one device. Written by a
 * member who already holds the key; openable only by that device.
 */
/**
 * A Sender Key Distribution Message, sealed for exactly one recipient device.
 * This is the Signal/WhatsApp group design rather than one shared group key.
 * Every sending device owns its own chain: a random chain key that ratchets
 * forward one way per message, so a key captured today cannot open yesterday's
 * messages. The chain is handed to each recipient device once, sealed to that
 * device's public key, and after that the sender simply sends.
 */
model SenderKeyEnvelope {
  id              String    @id @default(cuid())
  cartId          String
  cart            GroupCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User      @relation("SentSenderKeys", fields: [senderId], references: [id], onDelete: Cascade)
  senderDevice    String
  recipientId     String
  recipient       User      @relation("ReceivedSenderKeys", fields: [recipientId], references: [id], onDelete: Cascade)
  recipientDevice String
  /**
   * Base64 SPKI of the ephemeral public key used for the ECDH that sealed it.
   */
  senderKey       String
  iv              String
  /**
   * Chain key, chain index and the sender's group signing key, encrypted.
   * Meaningless to the server.
   */
  payload         String
  createdAt       DateTime  @default(now())

  @@unique([cartId, senderDevice, recipientDevice])
  @@index([cartId, recipientDevice])
}

/**
 * A conversation's past, handed from one of a user's own devices to another of
 * their devices.
 * A ratchet means a new device genuinely cannot derive the keys for messages
 * sent before it existed — that is forward secrecy working, not a bug. So
 * history moves the way WhatsApp moves it: an existing device of the SAME user,
 * holding the plaintext locally, re-encrypts it and seals it for the new
 * device. Never across users: nobody else's device should be able to hand you a
 * version of the conversation.
 */
model HistorySync {
  id         String    @id @default(cuid())
  cartId     String
  cart       GroupCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromDevice String
  toDevice   String
  senderKey  String
  iv         String
  /**
   * The past messages, encrypted for the receiving device alone.
   */
  payload    String
  createdAt  DateTime  @default(now())

  @@unique([cartId, toDevice])
  @@index([cartId, userId])
}

/**
 * One chat message. The server stores the nonce and the ciphertext and knows
 * who sent it and when — it cannot know what it says.
 */
model GroupMessage {
  id           String    @id @default(cuid())
  cartId       String
  cart         GroupCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  senderId     String
  sender       User      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  /**
   * Which of the sender's devices wrote it. A user with a phone and a laptop
   * has two chains, and a message only opens by ratcheting the right one.
   */
  senderDevice String    @default("")
  /**
   * Position in that device's chain. The receiver ratchets forward to here.
   */
  index        Int       @default(0)
  /**
   * Protocol version, so a later change never has to guess at old rows.
   */
  version      Int       @default(2)
  iv           String
  ciphertext   String
  /**
   * ECDSA signature by the sending device's group signing key. This is what
   * stops one member writing a message that looks like another member's.
   */
  signature    String?
  createdAt    DateTime  @default(now())

  @@index([cartId, createdAt])
  @@index([cartId, senderDevice, index])
}

// Explicit membership: created when someone joins via code (and for the host).
// Gates who may read/add to a cart, independent of whether they've added items.
model GroupCartMember {
  id        String    @id @default(cuid())
  cartId    String
  cart      GroupCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([cartId, userId])
  @@index([userId])
}

model GroupCartItem {
  id         String    @id @default(cuid())
  cartId     String
  cart       GroupCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dishId     String
  name       String
  pricePaise Int // unit effective price snapshot
  qty        Int       @default(1)
  createdAt  DateTime  @default(now())

  @@index([cartId])
}

// "Tell me when this drops below ₹X." A background loop checks active alerts
// against the latest observed prices and fires a push + realtime event.
model PriceAlert {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain        String // "food" | "ride"
  itemKey       String // dishId (food) or vehicle type (ride)
  itemName      String // human label shown in the notification
  targetPaise   Int // notify when best price <= this
  lastSeenPaise Int // price at the time the alert was created
  active        Boolean   @default(true)
  triggeredAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId, active])
  @@index([domain, itemKey, active])
}

// Observed best prices over time. Every quote generation logs one row, so the
// timing advisor can learn real hour-of-day patterns instead of fixed rules.
model PriceObservation {
  id        String   @id @default(cuid())
  domain    String // "food" | "ride"
  key       String // dishId (food) or vehicle type (ride)
  hour      Int // 0–23, local hour the quote was seen
  weekday   Int // 0–6 (Mon=0)
  bestPaise Int // cheapest effective price at that moment
  createdAt DateTime @default(now())

  @@index([domain, key, hour])
}

// Web Push subscriptions (W3C Push API). One row per browser/device a user
// has granted notification permission on. `endpoint` is unique per device.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String // client public key
  auth      String // client auth secret
  // The VAPID public key this subscription was created with. A subscription
  // only accepts pushes signed by that key, so after a rotation the older
  // ones are removed rather than tried. Null for rows from before this was
  // recorded, which are tried as before.
  vapidKey  String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// One-time codes for email verification now; `channel` supports "phone"
// so SMS OTP can be added later without a schema change.
model OtpCode {
  id         String    @id @default(cuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel    String // "email" | "phone"
  target     String // email address or phone number the code was sent to
  codeHash   String // bcrypt hash — raw codes are never stored
  purpose    String // "signup" | "login" | "reset"
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([target, purpose])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  // Whether this session cleared operator step-up (2FA). Carried across refresh
  // rotation so a stepped-up console session keeps the `step` claim on its new
  // access token; ordinary user sessions stay false.
  stepUp     Boolean   @default(false)
  // Recorded at sign-in so Login Activity can name the device rather than
  // listing anonymous rows. Carried across refresh rotation.
  userAgent  String?
  ip         String?
  lastUsedAt DateTime?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String // "Home" | "Work" | custom
  line1        String // flat / house no.
  line2        String? // building / street name
  landmark     String?
  // Who receives the delivery at this address — may differ from the account.
  contactName  String?
  contactPhone String?
  city         String
  state        String
  pincode      String
  lat          Float?
  lng          Float?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model ChatSession {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  // What chat remembers between messages (JSON, see agent/state.ts): what it
  // last showed, what was last added, the active group, an action awaiting
  // confirmation. Kept as explicit state rather than re-read from the
  // transcript, so "add that too" means exactly one thing.
  agentState String?
  // Set from the chat's menu in the sidebar. A pinned chat is listed first; an
  // archived one leaves the recent list until it is unarchived or written in.
  pinnedAt   DateTime?
  archivedAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String // "user" | "assistant"
  content   String
  intent    String? // JSON: extracted intent / recommendation payload

  // Which model produced `intent`, and how far down the provider chain we had
  // to go to get it. Recorded because the plan is to train our own decision
  // engine on this corpus: without provenance it is a blend of three vendors
  // and a rule-based fallback, and nothing can separate them afterwards.
  // Retroactive labelling is impossible, so this has to be captured from the
  // first message onward.
  provider      String? // "anthropic" | "google" | "deepseek" | "demo"
  providerDepth Int? // 0 = first choice served it; >0 = a fallback did

  createdAt DateTime @default(now())

  @@index([sessionId])
  // Training pulls select by provider and date; ops query "how often are we
  // falling back" over the same shape.
  @@index([provider, createdAt])
}

// Unified order for both domains; domain-specific details live in `details` JSON.
model Order {
  id           String        @id @default(cuid())
  // Fingerprint of the request that created this order.
  //
  // A double-tap, a flaky connection retrying, or a back-then-submit all send
  // the same request twice, and without this each one became a separate order
  // the customer could be charged for. Unique per user rather than globally:
  // two people ordering the same dish from the same place in the same minute
  // is ordinary, and must not collide.
  requestKey   String?
  rideMessages RideMessage[]
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain       String // "food" | "ride"
  status       String // "created" | "pending_payment" | "confirmed" | "in_progress" | "completed" | "cancelled"
  provider     String // "ondc" | "swiggy" | "zomato" | "uber" | "ola" | "rapido" (simulated for now)
  fulfillment  String // "in_app" (ONDC) | "redirect" (closed platform)
  title        String // human-readable summary, e.g. "Dum Biryani — Hotel Paradise"
  details      String // JSON: items / route / provider quote snapshot
  amount       Int // paise — integer money, never floats
  savedPaise   Int           @default(0) // vs next-best option at decision time
  currency     String        @default("INR")
  addressId    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  payment        Payment?
  trackingEvents TrackingEvent[]
  rating         OrderRating?

  @@unique([userId, requestKey])
  @@index([userId, domain])
}

model Payment {
  id              String   @id @default(cuid())
  orderId         String   @unique
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gateway         String   @default("cashfree")
  gatewayOrderId  String?  @unique // Cashfree order id
  amount          Int // paise
  currency        String   @default("INR")
  status          String // "created" | "processing" | "success" | "failed" | "refunded"
  method          String? // "upi" | "card" | "netbanking"
  gatewayResponse String? // JSON: last webhook/verify payload
  // When the money was taken. createdAt is when checkout began, which can be
  // long before; the free cancellation window runs from this instead.
  paidAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TrackingEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String // e.g. "order_placed" | "preparing" | "out_for_delivery" | "driver_assigned" | "arriving" | "completed"
  message   String
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())

  @@index([orderId])
}

// --- Back-office (admin / super-admin / developer consoles) ---

// Append-only record of every privileged action. Written by the audit service
// on each mutating admin/super operation. There is no update or delete path —
// the super-admin reviews it as a tamper-evident trail (who did what, to whom,
// from where). actorId is null only for system-originated entries.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String? // the operator who acted (null = system)
  actorRole  String // role at the time of the action
  action     String // e.g. "user.suspend", "role.grant", "order.refund_flag"
  targetType String // "user" | "order" | "ticket" | "flag" | ...
  targetId   String? // id of the affected entity
  summary    String // human-readable one-liner for the audit feed
  metadata   String? // JSON: before/after or extra context
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// Append-only record of every action the chat agent carries out for a customer.
// Written fire-and-forget after the action runs, so auditing never slows the
// reply. Gives the team a tamper-evident trail of what the agent did, when,
// and what changed — the back-office AuditLog does the same for admin actions.
model AgentActionLog {
  id         String   @id @default(cuid())
  userId     String
  sessionId  String
  messageId  String?
  actionKind String // "cart.add" | "group.create" | "ride.book" | ...
  success    Boolean
  request    String // JSON: the parsed AgentAction that was executed
  changes    String? // JSON: before/after state, created entity ids, etc.
  error      String?
  decisionId String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([sessionId])
  @@index([actionKind, createdAt])
}

// Captured server errors, surfaced on the developer console. Every unhandled
// error flows here via the error handler so engineers see failures without SSH.
// fingerprint groups identical errors; count rises instead of spamming rows.
model ErrorLog {
  id          String   @id @default(cuid())
  fingerprint String   @unique // hash of name+message+top frame
  name        String // error class, e.g. "TypeError"
  message     String
  stack       String?
  route       String? // method + path that triggered it
  statusCode  Int? // HTTP status returned, if any
  userId      String? // affected user, when known (no PII beyond id)
  count       Int      @default(1) // occurrences of this fingerprint
  resolved    Boolean  @default(false) // engineer marks handled
  firstSeen   DateTime @default(now())
  lastSeen    DateTime @default(now())

  @@index([resolved, lastSeen])
}

// Support / Issue-&-Grievance (ONDC IGM-shaped) ticket raised by a user and
// worked by admins. Keeps order disputes auditable end to end.
model SupportTicket {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId         String? // optional link to the order in question
  category        String // "order" | "payment" | "refund" | "account" | "other"
  subject         String
  body            String
  status          String    @default("open") // "open" | "in_progress" | "resolved" | "closed"
  priority        String    @default("normal") // "low" | "normal" | "high" | "urgent"
  assigneeId      String? // admin handling it
  resolution      String? // closing note
  // Support policy 3.2 publishes a response and a resolution time per issue
  // type. Storing both deadlines on the row is what turns that table from a
  // promise on a page into something we can be measured against.
  slaRespondBy    DateTime?
  slaResolveBy    DateTime?
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  // 1 frontline, 2 specialist, 3 management (support policy 3.5).
  escalationLevel Int       @default(1)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, priority])
  @@index([userId])
}

// Server-side feature flags, toggled from the developer console. Lets us gate
// risky features (e.g. switch LLM_PROVIDER behaviour, enable ONDC live) without
// a redeploy. Read at request time; default off when absent.
model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "ondc_live", "hybrid_ai_rerank"
  enabled     Boolean  @default(false)
  description String?
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

// API keys for MSME / developer-partner integrations (managed from the
// super-admin console). We store only a SHA-256 hash of the secret — the raw
// key is shown exactly once at creation and never persisted, so a DB leak
// exposes nothing usable. `prefix` is a non-secret label for display/lookup.
model ApiKey {
  id          String    @id @default(cuid())
  name        String // e.g. "Production — MK Electronics"
  client      String // owning partner / integration
  prefix      String    @unique // e.g. "alg_live_4f2a" (non-secret, shown in UI)
  keyHash     String    @unique // sha256 of the full key
  scope       String    @default("read") // "read" | "read_write"
  createdById String?
  lastUsedAt  DateTime?
  callCount   Int       @default(0)
  expiresAt   DateTime? // null = no expiry
  revokedAt   DateTime? // set instead of deleting, for audit continuity
  createdAt   DateTime  @default(now())

  @@index([revokedAt])
}

// ONDC transaction log (developer console). Flouna is a BAP: every order is a
// Beckn flow of signed request/callback pairs (search→on_search, select→
// on_select, confirm→on_confirm, status→on_status). Until participant
// registration these are SIMULATED from real orders but recorded in the exact
// envelope shape, so the viewer — and any downstream tooling — works unchanged
// the moment the network goes live. `simulated` flags pre-registration rows.
model OndcTransaction {
  id        String   @id @default(cuid())
  txnId     String // Beckn transaction_id (one per order/journey)
  messageId String // Beckn message_id (one per request/callback pair)
  action    String // "search" | "on_search" | "select" | "confirm" | "on_confirm" | "status" | "on_status"
  domain    String // ONDC domain code, e.g. "ONDC:RET11" (food) / "ONDC:TRV11"
  orderId   String? // our order this relates to, when applicable
  bppId     String? // the seller app (BPP) the message went to/from
  request   String? // JSON: the Beckn request envelope (context + message)
  response  String? // JSON: the matching callback envelope, when present
  status    String // "ack" | "nack" | "error"
  signed    Boolean  @default(true) // request carried an Ed25519 signature
  latencyMs Int? // round-trip for request→callback, when known
  simulated Boolean  @default(true) // pre-registration synthetic record
  // Signer and digest of an inbound message's exact bytes. Unique, so a seller
  // resending the same message stores it once however many servers are
  // running and however long ago the first copy came. Null on rows we wrote.
  dedupeKey String?  @unique
  createdAt DateTime @default(now())

  @@index([txnId])
  @@index([action, createdAt])
  @@index([orderId])
}

// Singleton-ish platform configuration set from the super-admin Settings page:
// commission thresholds (kept within DPIIT/ONDC norms) and alert thresholds. A
// single row with key "default"; values are integers/basis-points to avoid
// floats. Read by services that enforce or display these limits.
model PlatformConfig {
  id                      String   @id @default(cuid())
  key                     String   @unique @default("default")
  // Commission thresholds in basis points (1% = 100 bps) — integer money rule.
  ondcMinMarginBps        Int      @default(300) // 3.0%
  ondcMaxMarginBps        Int      @default(600) // 6.0%
  partnerAffiliateMinBps  Int      @default(120) // 1.2%
  cashbackUserSharePct    Int      @default(30) // % of cashback passed to user
  // Alert thresholds.
  apiFailureRatePct       Int      @default(1) // alert when failure% exceeds
  decisionLatencyAlertSec Int      @default(5)
  ondcPingAlertMs         Int      @default(500)
  updatedById             String?
  updatedAt               DateTime @updatedAt
  createdAt               DateTime @default(now())
}

// Promo codes entered by the buyer at checkout. The discount is always
// recomputed server-side from these rules — the client only ever sends a code.
model Coupon {
  id               String    @id @default(cuid())
  code             String    @unique // stored uppercase
  description      String
  // "percent" (percentOff of the item subtotal, capped by maxDiscountPaise)
  // or "flat" (valuePaise straight off).
  kind             String
  percentOff       Int? // 1–100 when kind = "percent"
  valuePaise       Int? // when kind = "flat"
  maxDiscountPaise Int? // cap for percent coupons
  minOrderPaise    Int       @default(0)
  domain           String    @default("food") // "food" | "ride" | "any"
  firstOrderOnly   Boolean   @default(false)
  active           Boolean   @default(true)
  expiresAt        DateTime?
  usageLimit       Int? // total redemptions allowed across all users
  usedCount        Int       @default(0)
  createdAt        DateTime  @default(now())

  redemptions CouponRedemption[]
}

// One row per successful redemption — enforces per-user limits and gives ops a
// real audit trail instead of inferring from order JSON.
model CouponRedemption {
  id            String   @id @default(cuid())
  couponId      String
  userId        String
  orderId       String   @unique
  discountPaise Int
  createdAt     DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
}

// Post-delivery rating. One per order; the dish/provider it refers to is
// denormalised so community averages can be computed without re-parsing order
// JSON. These averages feed back into the recommendation scoring.
model OrderRating {
  id        String   @id @default(cuid())
  orderId   String   @unique
  userId    String
  domain    String // "food" | "ride"
  itemKey   String // dishId for food, provider for rides
  stars     Int // 1–5
  comment   String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([domain, itemKey])
  @@index([userId])
}

// A per-search record of how a recommendation was reached.
//
// ONDC's buyer-app disclosure asks a buyer app to account for its listing and
// ranking behaviour. Price observations tell us what a thing cost; they do not
// tell us why one option was placed above another. Without this table a past
// recommendation cannot be reconstructed after the fact — which was the honest
// answer given at section 17 of the developer questionnaire.
//
// Written fire-and-forget on the quote path, so a failure here never affects a
// user's request. Retained for a bounded window by the maintenance job.
model DecisionLog {
  id     String  @id @default(cuid())
  userId String? // null for unauthenticated or demo traffic
  domain String // "food" | "ride"
  query  String // the user's search text, or a route summary for rides

  // The ranking configuration actually applied to this search.
  priority     String // "price" | "rating" | "speed" | "balanced"
  weights      String // JSON {price,rating,speed} AFTER any personalisation
  personalized Boolean @default(false)

  // What the engine saw and what it did with it.
  candidateCount Int // options scored
  excludedCount  Int // options removed by filters before scoring
  exclusions     String? // JSON [{rule,count}] — why results were dropped
  results        String // JSON [{key,pricePaise,rating,etaMinutes,score}], best first
  chosenKey      String // the option presented as the recommendation

  // What the customer did with it.
  //
  // Without these the log answers "what did we recommend" and nothing else,
  // which is half a sentence. A ranker learns from the gap between the option
  // offered and the option taken, so until this pairing exists there is no
  // training signal at all and the weights can only ever be hand-set guesses.
  //
  // Null is meaningful rather than missing: a search nobody ordered from is
  // evidence about the recommendation, not an absent row.
  selectedKey String? // the option actually chosen, in the same key space as results
  selectedAt  DateTime?
  orderId     String?   @unique // the order it became, when it became one

  createdAt DateTime @default(now())

  @@index([domain, createdAt])
  @@index([userId])
  // Serves the ranker's extract: every decision that produced a choice.
  @@index([domain, selectedAt])
}

// An entry in the consent log. Append-only: a consent record is evidence, and
// evidence you can edit is not evidence. Withdrawal is a new row rather than an
// update to the old one, so the history stays readable end to end.
//
// kind: "terms" | "cookies" | "ai_training" | "marketing"
model ConsentRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  granted   Boolean
  version   String? // policy version this refers to, where one applies
  detail    String? // JSON, e.g. the per-category cookie choice
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, kind])
}

// A data-subject request under the privacy policy: a copy of your data (6.1),
// erasure (6.2), or exclusion from model training (6.4).
//
// Each carries the deadline the policy commits to, written when it is created.
// Reading the deadline off the row rather than recomputing it means a later
// edit to the policy cannot silently move a promise we already made.
//
// kind:   "export" | "deletion" | "training_opt_out"
// status: "pending" | "in_progress" | "completed" | "rejected" | "cancelled"
model PrivacyRequest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind   String
  status String @default("pending")

  dueBy       DateTime // 30 days for export, 45 for deletion
  completedAt DateTime?

  // Export only: where the bundle lives and when it stops being downloadable.
  // Short-lived by design, since it is the most sensitive single object we
  // ever produce about one person.
  artifactPath String?
  expiresAt    DateTime?

  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, kind])
  @@index([status, dueBy])
}

// A challenge to something the decision engine chose (AI policy 2.5 and 2.6).
//
// 2.6 is the part with legal weight: a person may require that a human looks
// at an automated decision. humanReviewRequested records that this was asked
// for, so it can never be answered by the same automation being appealed.
//
// status: "open" | "reviewing" | "answered" | "closed"
model DecisionAppeal {
  id            String  @id @default(cuid())
  userId        String
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  decisionLogId String? // the recommendation being contested, when known
  orderId       String?

  reason               String // what they wanted instead
  wanted               String? // "cheaper" | "faster" | "better_rated" | "other"
  humanReviewRequested Boolean @default(false)

  status      String    @default("open")
  dueBy       DateTime // 5 business days (AI policy 2.5)
  reviewerId  String?
  response    String?
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status, dueBy])
}

// A security incident that may require notifying affected people and the
// regulator. The breach policy commits to 72 hours from becoming aware, so
// that clock is a stored deadline rather than something worked out later in
// the middle of an incident.
//
// severity: "low" | "medium" | "high" | "critical"
// status:   "detected" | "investigating" | "contained" | "notified" | "closed"
model BreachIncident {
  id          String @id @default(cuid())
  reference   String @unique
  title       String
  description String
  severity    String @default("medium")
  status      String @default("detected")

  detectedAt          DateTime  @default(now())
  notifyDueBy         DateTime // detectedAt + 72h
  containedAt         DateTime?
  usersNotifiedAt     DateTime?
  regulatorNotifiedAt DateTime?

  affectedCount  Int     @default(0)
  dataCategories String? // JSON array of what was exposed
  remediation    String?

  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, notifyDueBy])
}

/// A message between a rider and the driver of one ride.
///
/// The rider's own messages are real and kept here. The driver's side is
/// produced by the simulation that already invents the driver's name, plate
/// and OTP, and is marked as such rather than being passed off as a person
/// typing: `simulated` is what the screen reads to keep saying so.
model RideMessage {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// "rider" or "driver". Not a userId: the driver is not an account here, and
  /// will be a provider identity rather than one of ours once rides are real.
  sender    String
  body      String
  /// Which line of the driver script this is, for the driver's side only.
  ///
  /// Deduping on the text itself looked equivalent and was not: the arrival
  /// line carries a countdown, so "about 2 minutes" and "about 1 minute" are
  /// different strings and the driver announced the ETA again every minute.
  /// The key is what is actually unique, and the constraint enforces it.
  scriptKey String?
  /// True while no live driver network is connected, so the rider is told.
  simulated Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([orderId, scriptKey])
  @@index([orderId, createdAt])
}

// A second model reading the same chat message beside the one that answers,
// to measure it on real traffic before it is trusted with customers. Never
// shown to anyone and never changes a reply. No user id: what is measured is
// the reading, not the person, and rows are pruned with the decision log.
model IntentWatch {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  watcher         String // provider being measured, e.g. "ollama"
  primaryProvider String // provider whose reading the customer got
  message         String
  agreed          Boolean // every compared field matched
  fields          String // JSON: field name -> true when the two agree
  primaryIntent   String // JSON
  watcherIntent   String? // JSON; null when the watcher failed
  latencyMs       Int
  error           String?

  @@index([createdAt])
}

// A search sent to the ONDC network on a customer's behalf. Seller apps answer
// it over the following seconds as on_search callbacks, stored in
// OndcTransaction under the same transaction id; this row ties those answers
// to who asked, what for, and from where, so only they can read them back and
// distances are measured from the right place.
model OndcSearch {
  id        String   @id // the Beckn transaction_id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  query     String
  lat       Float
  lng       Float
  city      String // STD code form, e.g. "std:080"
  // "sending" until the gateway responds, "sent" once acknowledged, "refused" if it did not or the send threw.
  status    String
  // The static terms this search stated (bap_terms), if any: every seller that
  // answered it was shown them.
  termsUrl       String?
  termsEffective String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Evidence that a seller app accepted our static terms (static terms 17.6.1):
// the version (address and effective date), who (the seller app's
// subscriber id), when, and how (an order placed through a search that stated
// those terms, confirmed by the seller's signed on_confirm). One row per seller
// app and version; later orders under the same version only add to the count.
model OndcTermsAcceptance {
  id              String   @id @default(cuid())
  bppId           String
  termsUrl        String
  termsEffective  String
  firstOrderId    String // our OndcOrder id
  firstMessageId  String // message_id of the seller's signed on_confirm (see OndcTransaction)
  firstAcceptedAt DateTime
  lastAcceptedAt  DateTime
  ordersAccepted  Int      @default(1)
  // The seller also said so outright (bpp_terms accept_bap_terms "Y"). ONDC's
  // validator does not ask for this yet, so most sellers will not send it.
  statedAccept    Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@unique([bppId, termsUrl, termsEffective])
}

// The customer's cart, held on the server so the app and chat act on the same
// one. Only what was chosen is stored: dish, listing and quantity. Names and
// prices are read from the catalogue every time, so a stored copy can never
// drift from what checkout charges.
model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id         String   @id @default(cuid())
  cartId     String
  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  dishId     String
  platform   String
  qty        Int
  // The ranking this line came from, when it came from one, so checkout can
  // pair the order with the recommendation it followed.
  decisionId String?
  // "app" or "chat": which surface put it there.
  addedVia   String   @default("app")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([cartId, dishId, platform])
  @@index([cartId])
}

// One food order placed with an ONDC seller, from the price check (select) to
// delivery. Kept apart from Order because its truth lives with the seller: the
// quote, the order id and every state change come from the seller's signed
// replies, and each is stored as it arrived (see ondc/orders.service.ts).
model OndcOrder {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  txnId            String    @unique // Beckn transaction_id, shared by every message of this order
  // The step we are waiting on, and the message_id we sent for it. A reply
  // with any other message_id is not the answer to our request.
  status           String // selecting | quoted | unavailable | initialising | ready_to_pay | paid | confirming | placed | failed | cancelling | cancelled
  awaitingMsgId    String?
  bppId            String
  bppUri           String
  providerId       String
  locationId       String
  storeName        String
  city             String // STD code form, "std:080"
  lines            String // JSON: CartLine[] as ordered
  addressId        String?
  gps              String?
  areaCode         String?
  fulfillmentId    String?
  // The static terms stated on the search this order came from, if any.
  termsUrl         String?
  termsEffective   String?
  tat              String? // ISO 8601 duration the seller committed to, "PT45M"
  quote            String? // JSON: the seller's latest quote, exactly as sent
  totalPaise       Int?
  payment          String? // JSON: the seller's payment terms from on_init (collector, settlement details)
  paidAt           DateTime?
  paymentRef       String? // the payment's transaction id, sent in confirm
  paidPaise        Int? // what the gateway actually took
  // Money owed back to the customer: the paid amount less what the seller
  // finally charged. "owed" until sent to the gateway, "review" when the
  // amount needs a person to decide.
  refundPaise      Int?
  refundStatus     String? // owed | review | requested | done | failed
  refundRef        String?
  completedAt      DateTime? // when the seller reported it delivered
  sellerOrderId    String?
  sellerState      String? // Created | Accepted | In-progress | Completed | Cancelled
  fulfillmentState String? // Pending | Packed | Agent-assigned | Order-picked-up | Out-for-delivery | Order-delivered | Cancelled
  // Seller's context.timestamp of the last state we applied. A slower,
  // older message must not overwrite a newer state.
  sellerUpdatedAt  DateTime?
  problem          String? // why the seller refused, in plain words
  cancelReasonId   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, createdAt])
}

// What Flouna owes a seller app for one paid ONDC order: the seller's final
// total less our finder fee, due after the settlement window the seller set.
// Paid by an operator, who records the bank reference. Nothing here moves
// money on its own.
model OndcPayout {
  id               String    @id @default(cuid())
  ondcOrderId      String    @unique
  bppId            String
  orderTotalPaise  Int
  feePaise         Int
  amountPaise      Int // orderTotalPaise - feePaise
  settlement       String // JSON: the seller's settlement details from on_init
  settlementWindow String? // "P3D"
  settlementBasis  String? // "return_window_expiry" | "delivery" | ...
  dueAt            DateTime
  // due | paid | held | via_rsf (paid through ONDC settlement instead: see
  // OndcSettlement; never also paid by hand)
  status           String    @default("due")
  paidAt           DateTime?
  utr              String? // the bank's reference for the transfer
  paidBy           String? // operator user id
  note             String?
  createdAt        DateTime  @default(now())

  @@index([status, dueAt])
}

// One ride booked with an ONDC ride provider (TRV10), from the search to the
// end of the trip. Rides keep one transaction from search to completion, so
// the row is created with the search and found by it afterwards. The
// provider collects the fare; Flouna only records what it was told.
model OndcRide {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  txnId             String    @unique
  // searching | selecting | quoted | initialising | ready | confirming |
  // booked | cancel_quoting | cancel_quoted | cancelling | cancelled |
  // completed | failed
  status            String
  awaitingMsgId     String?
  city              String // STD code form, "std:080"
  pickup            String // JSON: { gps, address, area }
  drop              String // JSON: { gps, address, area }
  bppId             String?
  bppUri            String?
  providerId        String?
  itemId            String?
  fulfillmentId     String?
  vehicle           String?
  quote             String? // JSON: the provider's latest quote, as sent
  farePaise         Int?
  payment           String? // JSON: the provider's payment terms from on_init
  cancellationTerms String? // JSON: the fee at each stage, from on_init
  cancelReasonId    String?
  cancelFeePaise    Int? // what the provider said cancelling would cost
  sellerOrderId     String?
  orderStatus       String? // ACTIVE | COMPLETED | CANCELLED | SOFT_CANCEL
  rideState         String? // RIDE_ASSIGNED, RIDE_ENROUTE_PICKUP, ...
  driver            String? // JSON: { name, phone }
  vehicleInfo       String? // JSON: { registration, make, model, color }
  startOtp          String?
  sellerUpdatedAt   DateTime?
  problem           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId, createdAt])
}

// ONDC settlement (RSF 2.0.0, domain ONDC:NTS10) for one completed order.
//
// Whoever collected the customer's money is the "collector"; the other app is
// the "receiver". Both send the settlement agency (NBBL's NOCS) matching
// instructions for the order, and it moves the money between their settlement
// accounts. Amounts are integer paise, worked out once when the order
// completes, from the seller's own terms in on_init.
model OndcSettlement {
  id                    String    @id @default(cuid())
  ondcOrderId           String    @unique
  bppId                 String
  networkOrderId        String // the order id on the network: the seller's, from on_confirm
  role                  String // "receiver" (the seller collected) | "collector" (Flouna collected)
  orderTotalPaise       Int
  feePaise              Int // the Buyer Finder Fee: our commission
  withholdingPaise      Int       @default(0)
  tcsPaise              Int       @default(0)
  tdsPaise              Int       @default(0)
  interParticipantPaise Int // what moves from the collector to the receiver
  collectorPaise        Int // what the collector keeps
  selfPaise             Int // what lands in our own operating account
  settlementBasis       String?
  settlementWindow      String?
  dueAt                 DateTime
  // held (a person must release it) | due | instructed (sent, the agency
  // acknowledged) | settled | not_settled
  status                String
  note                  String?
  settlementId          String? // settlement.id of the instruction carrying it
  settleTxnId           String?
  settleMsgId           String?
  instructedAt          DateTime?
  settledPaise          Int?
  referenceNo           String? // the agency's reference for the transfer
  errorCode             String?
  errorMessage          String?
  settledAt             DateTime?
  // Reconciliation with the seller app: null | sent | accord | dispute
  reconStatus           String?
  reconTxnId            String?
  reconAt               DateTime?
  counterpartyView      String? // JSON: the seller app's figures from its recon / on_recon
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status, dueAt])
  @@index([settlementId])
  @@index([bppId, networkOrderId])
}

// ONDC Network Observability outbox: one row per log, already anonymised,
// waiting to be pushed to ONDC's logging service (see ondc/observability.ts).
model OndcNoLog {
  id        String    @id @default(cuid())
  domain    String
  type      String // "on_search", "select_response", ...
  payload   String // the { type, data } body exactly as it is pushed
  attempts  Int       @default(0)
  lastError String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([sentAt, createdAt])
}

