# Flouna — production environment.
#
# Copy to .env on the server and fill in. The app REFUSES TO BOOT if any of the
# required values below are wrong, and says which — see src/config/env.ts. That
# is deliberate: every check here corresponds to a way the app would otherwise
# fail quietly in front of real users.

NODE_ENV=production
PORT=4000

# --- Required: the app will not start without these -----------------------

# Postgres. A SQLite URL is refused in production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/flouna

# Must be https, and must share a registrable domain with the API host or
# session cookies are rejected as cross-site and users get logged out.
#   web  https://flouna.com          <- this value
#   api  https://api.flouna.com
WEB_ORIGIN=https://flouna.com

# 48+ random chars each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Payments. Without these, checkout dead-ends: simulated payment is disabled in
# production, so there would be no way for a customer to pay.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=production

# --- Fulfilment -----------------------------------------------------------
#
# Leave PROVIDER_MODE=simulation until ONDC onboarding completes, and set the
# pilot flag so the boot gate allows it. The app then tells riders their trip
# is simulated. Do not set the flag without that notice being visible.
PROVIDER_MODE=simulation
ALLOW_SIMULATED_FULFILMENT=true

# After onboarding: PROVIDER_MODE=ondc and fill these in, then remove the flag.
# ONDC_BASE_URL=
# ONDC_SUBSCRIBER_ID=
# ONDC_SIGNING_PRIVATE_KEY=
# ONDC_SIGNING_PUBLIC_KEY=

# --- Email ----------------------------------------------------------------
# The sender must be verified with Brevo AND its domain must resolve, or every
# OTP and receipt fails silently. Use the Algorithec address until flouna.com
# is verified.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Flouna <info@algorithec.com>"

# --- AI -------------------------------------------------------------------
# Omit to run the rule-based engine; boot warns when it is doing so.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=

# --- Maps -----------------------------------------------------------------
GEOAPIFY_KEY=
ORS_KEY=
# Google Maps Platform: Routes API + Places API (New) + Geocoding API.
# Optional. Set it only together with the web's NEXT_PUBLIC_GOOGLE_MAPS_KEY —
# Google's terms forbid drawing its data on a non-Google map. Restrict the key
# by API, and the web key by HTTP referrer, in the Google Cloud console.
GOOGLE_MAPS_API_KEY=

# --- Web push -------------------------------------------------------------
# Generate FRESH keys for production: npx web-push generate-vapid-keys
# Push requires HTTPS. Boot warns if the public key is absent.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@flouna.com

# --- Storage --------------------------------------------------------------
# Complaint evidence. Point at a persistent volume — the default is lost on
# every redeploy on an ephemeral filesystem, and evidence is ONDC grievance
# material.
UPLOAD_DIR=/var/lib/flouna/uploads

# --- Android (Trusted Web Activity) ---------------------------------------
# Set on the WEB deployment, not the API. SHA-256 of the APK signing key,
# uppercase hex with colons, from:
#   keytool -list -v -keystore flouna.keystore -alias flouna
# Until this is set, /.well-known/assetlinks.json returns an empty list and the
# installed app shows a browser URL bar.
# ANDROID_SIGNING_SHA256=
# ANDROID_PACKAGE_NAME=com.flouna.app
