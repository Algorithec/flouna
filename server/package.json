{
  "name": "flouna-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Flouna API server — AI decision engine for food & rides",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "node scripts/set-db-provider.mjs && prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:provider": "node scripts/set-db-provider.mjs",
    "db:deploy": "node scripts/set-db-provider.mjs postgresql && node scripts/pg-baseline.mjs --apply",
    "db:sync": "node scripts/set-db-provider.mjs postgresql && prisma db execute --file prisma/pre-push.sql --schema prisma/schema.prisma && prisma db push --skip-generate",
    "db:backup": "node --env-file=.env scripts/backup-db.mjs",
    "set-role": "node --env-file=.env scripts/set-role.mjs",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx prisma/seed.ts",
    "db:deploy:check": "node scripts/set-db-provider.mjs postgresql && node scripts/pg-baseline.mjs",
    "start:local": "node --env-file=.env dist/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@prisma/client": "^6.8.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^10.7.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^6.0.2",
    "nodemailer": "^10.1.7",
    "prisma": "^6.8.0",
    "proxy-addr": "^2.0.8",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.0",
    "@types/web-push": "^3.6.4",
    "supertest": "^7.2.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
