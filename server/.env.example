# Copy to .env and fill in values. Never commit .env.

NODE_ENV=development
PORT=4000
DATABASE_URL="file:./dev.db"
WEB_ORIGIN=http://localhost:3000
# Where complaint evidence is written. Relative paths resolve from server/.
# Point this at durable storage in production — the default is not persistent
# on ephemeral disks. Tests override it with a temp directory.
UPLOAD_DIR=uploads

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Google OAuth (https://console.cloud.google.com → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mail for login codes: Brevo's HTTPS API (BREVO_API_KEY), which gets past the
# outbound SMTP block most hosts apply, or SMTP. Leave both empty in dev and the
# codes print to the console. Production refuses to start without one of them.
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# The sender address must be VERIFIED with the SMTP provider (Brevo), and its
# domain must actually exist, or every outbound email silently fails. Until
# flouna.app is registered and verified, use the verified Algorithec address:
#   MAIL_FROM="Flouna <info@algorithec.com>"
MAIL_FROM="Flouna <no-reply@flouna.app>"

# LLM: ollama | anthropic | google | deepseek | nvidia | demo
# ollama = local fine-tuned Qwen (free, see model/ directory)
# One model attempt's limit before falling through to the next, in ms.
# LLM_TIMEOUT_MS=4000
LLM_PROVIDER=demo
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
NVIDIA_API_KEY=

# Ollama (local model, zero API cost — see model/README.md)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=flouna

# Cashfree (sandbox keys from https://merchant.cashfree.com)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# Maps
MAPTILER_KEY=
GEOAPIFY_KEY=
ORS_KEY=
# Google Maps Platform (server): Routes + Places. Optional; without it the
# app uses Geoapify/OpenRouteService and the offline estimates. Google's terms
# forbid showing its data on a non-Google map, so set this only together with
# the web's NEXT_PUBLIC_GOOGLE_MAPS_KEY.
GOOGLE_MAPS_API_KEY=

# Web push notifications — generate with: npx web-push generate-vapid-keys
# The public key must also be set as NEXT_PUBLIC_VAPID_PUBLIC_KEY in web/.env.local
#
# Rotating them (do it once before launch: the development keys must not be
# the production ones):
#   1. Generate a new pair. Set VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY here and
#      NEXT_PUBLIC_VAPID_PUBLIC_KEY in the web, then deploy the API and the web
#      together. The web reads its key at build time, so it needs a rebuild.
#   2. Every existing subscription was made with the old key and can no longer
#      receive anything. The API removes those on the next send rather than
#      trying them. In the app, Settings shows notifications as off for those
#      people, and turning them back on replaces the old subscription.
#   3. Nobody is told to resubscribe automatically, so expect push reach to dip
#      until people come back. Rotate before launch, not after.
#   4. Keep the private key out of chat and out of the repository. Push is
#      served only over HTTPS; a service worker will not register on http.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@flouna.app
# Bearer token checked by the reverse proxy in front of a remote Ollama.
# Use https for OLLAMA_URL, or the token travels in the clear.
OLLAMA_API_KEY=
# Measure a model beside the one answering customers, without it ever answering.
# e.g. LLM_WATCHER=ollama. LLM_WATCHER_SAMPLE is the share of messages (0 to 1).
# LLM_WATCHER=ollama
# LLM_WATCHER_SAMPLE=1
# Let the rules answer the messages they read cleanly, in under a millisecond,
# and send only doubtful ones to the model. Off unless set to true.
# HYBRID_ROUTING=true
# Error reporting. Paste the DSN from the Sentry project settings to send
# unexpected server errors there; leave empty to log them only.
SENTRY_DSN=

# ONDC commercial terms (founder decisions). Unset = safe defaults, warned at boot.
# BPP: the seller collects for food orders. BAP: Flouna collects and settles sellers.
ONDC_FOOD_PAYMENT_COLLECTOR=
# Percent of each order the seller pays Flouna, up to two decimals.
ONDC_FINDER_FEE_PERCENT=
# Where the finder fee is paid: a bank account and IFSC, or a UPI id.
ONDC_SETTLEMENT_ACCOUNT_NUMBER=
ONDC_SETTLEMENT_IFSC=
ONDC_SETTLEMENT_UPI=
ONDC_SETTLEMENT_BENEFICIARY=
# The published static terms and the date they apply from (YYYY-MM-DD).
# Set both or neither: food searches state them only once both are set.
ONDC_STATIC_TERMS_URL=
ONDC_STATIC_TERMS_EFFECTIVE_DATE=
# Algorithec's GSTIN. Every food confirm carries it; no food order starts without it.
ONDC_BAP_GSTIN=
# The settlement agency for ONDC settlement (RSF), from its onboarding (NBBL's NOCS).
# Set both or neither; without them nothing is settled, though sellers can still reconcile.
ONDC_SETTLEMENT_AGENCY_ID=
ONDC_SETTLEMENT_AGENCY_URL=
