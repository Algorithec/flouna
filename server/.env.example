# Copy to .env and fill in values. Never commit .env.

NODE_ENV=development
PORT=4000
DATABASE_URL="file:./dev.db"
WEB_ORIGIN=http://localhost:3000
# Where complaint evidence is written. Relative paths resolve from server/.
# Point this at durable storage in production — the default is not persistent
# on ephemeral disks. Tests override it with a temp directory.
UPLOAD_DIR=uploads

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Google OAuth (https://console.cloud.google.com → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP for email OTP — leave empty in dev (codes print to console)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# The sender address must be VERIFIED with the SMTP provider (Brevo), and its
# domain must actually exist, or every outbound email silently fails. Until
# flouna.app is registered and verified, use the verified Algorithec address:
#   MAIL_FROM="Flouna <info@algorithec.com>"
MAIL_FROM="Flouna <no-reply@flouna.app>"

# LLM: ollama | anthropic | google | deepseek | nvidia | demo
# ollama = local fine-tuned Qwen (free, see model/ directory)
LLM_PROVIDER=demo
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
NVIDIA_API_KEY=

# Ollama (local model, zero API cost — see model/README.md)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=flouna

# Cashfree (sandbox keys from https://merchant.cashfree.com)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# Maps
MAPTILER_KEY=
GEOAPIFY_KEY=
ORS_KEY=
# Google Maps Platform (server): Routes + Places. Optional; without it the
# app uses Geoapify/OpenRouteService and the offline estimates. Google's terms
# forbid showing its data on a non-Google map, so set this only together with
# the web's NEXT_PUBLIC_GOOGLE_MAPS_KEY.
GOOGLE_MAPS_API_KEY=

# Web push notifications — generate with: npx web-push generate-vapid-keys
# The public key must also be set as NEXT_PUBLIC_VAPID_PUBLIC_KEY in web/.env.local
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@flouna.app
