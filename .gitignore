# dependencies
node_modules/

# builds
web/.next/
server/dist/

# env & secrets — never commit
.env
.env.*
!.env.example
!.env.production.example
*.pem

# local databases
server/prisma/*.db
server/prisma/*.db-journal

# database backups (generated by scripts/backup-db.mjs)
server/backups/

# complaint evidence uploaded by customers — never committed, and served only
# through an authenticated route rather than as static files
server/uploads/

# local design references & internal notes (not for the repo)
.design-refs/
.claude/
CLAUDE.md

# OS / editor
.DS_Store
Thumbs.db
*.log

# scaffold-generated agent notes (kept local)
AGENTS.md


# Runtime upload storage (complaint evidence) — never committed
uploads/
server/uploads/

# Generated Postgres baseline preview (regenerate with npm run db:deploy:check)
server/prisma/pg-init.preview.sql

# Model weights (too large for git)
model/flouna-fused-*/
model/flouna-lora-*/
.vscode/
